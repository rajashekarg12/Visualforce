<apex:page standardController="Account" showHeader="true" cache="true"> 
    <!-- Hardcoded IDs (Avoid using specific record IDs in markup) -->
    <apex:outputText value="Account ID: 001XXXXXXXXXXXXXXX"/> 

    <apex:pageBlock title="Account Details">
        <apex:pageBlockSection>
            <!-- SOQL in Markup (Consider moving SOQL logic to Apex Controller) -->
            <apex:repeat value="{!SELECT Id, Name FROM Account}" var="acc">
                <apex:outputText value="{!acc.Name}"/>
            </apex:repeat>

            <!-- Inline JavaScript (Use Static Resource instead) -->
            <script>
                alert("This is not a best practice in Visualforce!");
            </script>

            <!-- Deprecated attributes -->
            <apex:outputField value="{! Account.Name }" rendered="true"/>
        </apex:pageBlockSection>
    </apex:pageBlock>

    <!-- Direct Reference to Controller Variable (Use Getter Methods Instead) -->
    <apex:outputText value="{!Account.Industry}" escape="false"/>

    <!-- Missing CSRF Protection (Command Button should have `action` instead of inline JavaScript) -->
    <apex:form>
        <apex:commandButton value="Delete Account" onclick="deleteAccount();"/>
    </apex:form>
</apex:page>
